
import math
import matplotlib.pyplot as plt

def valid_cluster_sizes(limit=20):
    return sorted({
        i*i + i*j + j*j
        for i in range(5)
        for j in range(5)
    } - {0})[:limit]

def reuse_metrics(N, S=336, M=21, n=4.0):
    k = S // N
    q = math.sqrt(3 * N)
    si_db = 10 * math.log10((q ** n) / 6)
    capacity = M * k
    return k, capacity, q, si_db

S = 336
M = 21
n = 4.0
req = 18.0

cluster_sizes = [1, 3, 4, 7, 9, 12, 13, 16, 19, 21]

print("S =", S, "channels")
print("M =", M, "cells")
print("Path loss exponent =", n)
print("Required S/I =", req, "dB")

print("\nN    D/R   Ch/Cell   Capacity   S/I(dB)   Meets?")

best = None
si_values = []
capacities = []

for N in cluster_sizes:
    k, C, q, si = reuse_metrics(N, S, M, n)

    ok = si >= req

    if ok and best is None:
        best = N

    si_values.append(si)
    capacities.append(C)

    print(f"{N:<4} {q:<6.2f} {k:<9} {C:<10} {si:<9.2f} {ok}")

print("\nSmallest cluster size =", best)

# Graph 1: S/I vs Cluster Size
plt.figure(figsize=(8, 5))
plt.plot(cluster_sizes, si_values, marker='o')
plt.axhline(req, linestyle='--', label="Required S/I")
plt.xlabel("Cluster Size (N)")
plt.ylabel("S/I (dB)")
plt.title("S/I vs Cluster Size")
plt.legend()
plt.grid()
plt.show()

# Graph 2: Capacity vs Cluster Size
plt.figure(figsize=(8, 5))
plt.plot(cluster_sizes, capacities, marker='o')
plt.xlabel("Cluster Size (N)")
plt.ylabel("System Capacity")
plt.title("Capacity vs Cluster Size")
plt.grid()
plt.show()

# Graph 3: Compare different S/I requirements
plt.figure(figsize=(8, 5))

for requirement in [18, 12, 9]:
    values = [
        reuse_metrics(N, S, M, n)[3]
        for N in cluster_sizes
    ]
    plt.plot(cluster_sizes, values, marker='o',
             label=f"Required S/I = {requirement} dB")
    plt.axhline(requirement, linestyle='--')

plt.xlabel("Cluster Size (N)")
plt.ylabel("S/I (dB)")
plt.title("S/I Comparison for Different Requirements")
plt.legend()
plt.grid()
plt.show()
