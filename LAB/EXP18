
import matplotlib.pyplot as plt

def erlang_b(E, C):
    b = 1.0
    for m in range(1, C + 1):
        b = E * b / (m + E * b)
    return b

def channels_needed(E, gos):
    C = 1
    while erlang_b(E, C) > gos:
        C += 1
    return C

def max_load(C, gos):
    lo = 0.0
    hi = 500.0

    for _ in range(60):
        mid = (lo + hi) / 2
        if erlang_b(mid, C) < gos:
            lo = mid
        else:
            hi = mid

    return lo

# Blocking probability table
loads = [2, 5, 10, 20]
channels = [5, 10, 20, 30]

print("BLOCKING PROBABILITY B(E,C)")
print("C       E=2      E=5      E=10     E=20")

for C in channels:
    print(f"{C:<8}", end="")
    for E in loads:
        print(f"{erlang_b(E, C):<9.4f}", end="")
    print()

# Offered traffic calculation
users = 2000
calls_per_hour = 1.5
hold_time = 120

E = users * calls_per_hour * hold_time / 3600

print("\nOFFERED TRAFFIC")
print("Users:", users)
print("Offered load:", E, "Erlang")

print("\nCHANNELS REQUIRED")

for gos in [0.05, 0.02, 0.01]:
    C = channels_needed(E, gos)
    print(f"GOS {gos:.0%}: Channels needed = {C}")

# Maximum load
print("\nMaximum load for 20 channels at 2% blocking:",
      round(max_load(20, 0.02), 2), "Erlang")

# Trunking efficiency comparison
total_load = 20

single_group = erlang_b(total_load, 30)
three_groups = 3 * erlang_b(total_load / 3, 10)

print("\nTRUNKING EFFICIENCY")
print("One group of 30 channels:", round(single_group, 4))
print("Three groups of 10 channels:", round(three_groups, 4))

# Graph 1: Blocking probability vs traffic
traffic = [i * 0.5 for i in range(1, 61)]

plt.figure(figsize=(8, 5))
for C in [5, 10, 20, 30]:
    blocking = [erlang_b(E, C) for E in traffic]
    plt.plot(traffic, blocking, label=f"C = {C}")

plt.xlabel("Offered Traffic (Erlang)")
plt.ylabel("Blocking Probability")
plt.title("Erlang B Blocking Probability")
plt.legend()
plt.grid()
plt.show()

# Graph 2: Channels required vs GOS
gos_values = [0.01, 0.02, 0.05, 0.10, 0.15]
required = [channels_needed(E, g) for g in gos_values]

plt.figure(figsize=(8, 5))
plt.plot([g * 100 for g in gos_values], required, marker='o')
plt.xlabel("Grade of Service (%)")
plt.ylabel("Number of Channels")
plt.title("Channels Required vs GOS")
plt.grid()
plt.show()

# Graph 3: Trunking comparison
plt.figure(figsize=(8, 5))
plt.bar(["30 Channels Together", "3 Groups of 10"],
        [single_group, three_groups])
plt.ylabel("Blocking Probability")
plt.title("Trunking Efficiency Comparison")
plt.grid(axis='y')
plt.show()
