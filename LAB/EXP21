
import numpy as np
import matplotlib.pyplot as plt

rng = np.random.default_rng(3)

U = 5
RB = 50
TTI = 3000

dist = np.array([100, 200, 300, 400, 500.0])

mean_snr_db = 40 - 35 * np.log10(dist / 100)
mean_snr = 10 ** (mean_snr_db / 10)

def rate(snr):
    return np.minimum(np.log2(1 + snr), 6.0) * 180

def simulate(sched):
    thr = np.zeros(U)
    avg = np.ones(U)

    for t in range(TTI):
        fade = rng.exponential(1.0, (U, RB))
        r = rate(mean_snr[:, None] * fade)

        if sched == "RR":
            owner = (np.arange(RB) + t) % U

        elif sched == "MAXCI":
            owner = r.argmax(axis=0)

        else:
            owner = (r / avg[:, None]).argmax(axis=0)

        got = np.zeros(U)

        for b in range(RB):
            got[owner[b]] += r[owner[b], b]

        avg = 0.99 * avg + 0.01 * got
        thr += got

    return thr / TTI / 1000

def jain(x):
    return x.sum() ** 2 / (len(x) * (x ** 2).sum())

# Run all schedulers
results = {}

print("OFDMA SCHEDULER SIMULATION")
print("\nSched   UE1     UE2     UE3     UE4     UE5    Total    Jain")

for s in ("RR", "MAXCI", "PF"):
    x = simulate(s)
    results[s] = x

    print(f"{s:6}", end="")

    for v in x:
        print(f"{v:8.2f}", end="")

    print(f"{x.sum():9.2f}{jain(x):8.3f}")

# Graph 1: User throughput
plt.figure(figsize=(9, 5))

for s, x in results.items():
    plt.plot(range(1, U + 1), x, marker='o', label=s)

plt.xlabel("User Number")
plt.ylabel("Throughput (Mbps)")
plt.title("User Throughput Comparison")
plt.legend()
plt.grid()
plt.show()

# Graph 2: Total throughput
plt.figure(figsize=(8, 5))

names = list(results.keys())
totals = [x.sum() for x in results.values()]

plt.bar(names, totals)
plt.xlabel("Scheduling Algorithm")
plt.ylabel("Total Throughput (Mbps)")
plt.title("Total Throughput Comparison")
plt.grid(axis='y')
plt.show()

# Graph 3: Jain fairness
plt.figure(figsize=(8, 5))

fairness = [jain(x) for x in results.values()]

plt.bar(names, fairness)
plt.xlabel("Scheduling Algorithm")
plt.ylabel("Jain Fairness Index")
plt.title("Fairness Comparison")
plt.ylim(0, 1.1)
plt.grid(axis='y')
plt.show()
